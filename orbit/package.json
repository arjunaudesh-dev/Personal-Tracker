{
  "name": "personal-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:layout && npm run test:ui",
    "test:layout": "esbuild tests/layout-audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/layout-audit.mjs --log-level=warning && node node_modules/.cache/layout-audit.mjs",
    "test:ui": "esbuild src/main.tsx --bundle --format=iife --loader:.css=empty --loader:.woff=empty --loader:.woff2=empty --define:process.env.NODE_ENV='\"production\"' --outfile=node_modules/.cache/orbit-app.js --log-level=warning && node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
