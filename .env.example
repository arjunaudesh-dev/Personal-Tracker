# NEXUS LIFE-OS Environment Variables
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Currency Exchange Configuration (Standard LKR Peg)
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_USD_TO_LKR_RATE=308.00

# Google Gemini AI Integration (Flash 2.5 / Pro 2.5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_RPM_LIMIT=15
GEMINI_PRO_RPM_LIMIT=2

# Supabase / PostgreSQL Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase Cloud Firestore Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nexus-life-os.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexus-life-os
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nexus-life-os.appspot.com

# Google Fit / Health Connect REST Integration
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret
