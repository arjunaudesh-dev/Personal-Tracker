# Copy to .env.local. All keys are optional — the app runs fully offline with built-in fallbacks.
# Google Gemini (bloodwork analysis + AI advisor). Without it, deterministic local analysis is used.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Optional: Firebase / Supabase (not required for local mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
