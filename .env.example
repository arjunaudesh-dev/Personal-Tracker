# ─────────────────────────────────────────────────────────────
# NEXUS LIFE-OS — Environment Template
# Copy to `.env.local` and fill in. Every integration degrades
# gracefully to deterministic local simulation when absent.
# ─────────────────────────────────────────────────────────────

# Google Gemini (AI Intelligence pipeline)
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Supabase (PostgreSQL relational mirror)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase / Firestore (document sync + offline cache)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Workspace (Calendar / Tasks / Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Wearable bridge (Google Fit REST / Health Connect)
GOOGLE_FIT_ACCESS_TOKEN=

# Firebase Admin (server-side token minting)
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
